{
    "include": [
        "@(srp_platform)/platform_definition/mavlink_link_service/mavlink_link_service.json"
    ],
    "package": "srp.platform.com",
    "adaptive_application": {
        "mavlink_daemon": {
            "app": {
                "functional_groups": [
                    "Startup2",
                    "Platform",
                    "Running",
                    "SafetyMode",
                    "MW"
                ],
                "parms": "",
                "logger": {
                    "app_id": "MAVD",
                    "app_des": "MAVLink Daemon",
                    "log_level": "kInfo",
                    "log_mode": "kRemote",
                    "ctx": []
                }
            },
            "provide": [
                {
                    "name": "srp.platform.mavlink.MavlinkLinkService as LinkServicePPort",
                    "on": "ipc",
                    "instance": 1
                }
            ]
        }
    }
}
