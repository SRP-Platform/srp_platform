{
    "include": [
        "example_app/models/ExampleApp/engine_service.json",
        "example_app/models/ExampleApp/example_service.json"
    ],
    "package": "srp.example",
    "adaptive_application": {
        "ExampleApp": {
            "app": {
                "functional_groups": [
                    "Running",
                    "SafetyMode"
                ],
                "parms": "-t -10- 100",
                "logger": {
                    "app_id": "EXA-",
                    "app_des": "Example Adaptive application",
                    "log_level": "kInfo",
                    "log_mode": "kRemote",
                    "ctx": [
                        {
                            "ctx_id": "ara",
                            "log_level": "kInfo",
                            "ctx_des": "Default ctx for ara"
                        },
                        {
                            "ctx_id": "acom",
                            "log_level": "kDebug",
                            "ctx_des": "Default ctx for ara::com"
                        },
                        {
                            "ctx_id": "adiag",
                            "log_level": "kInfo",
                            "ctx_des": "Default ctx for ara::diag"
                        },
                        {
                            "ctx_id": "exec",
                            "log_level": "kInfo",
                            "ctx_des": "Default ctx for ara::exec"
                        }
                    ]
                }
            },
            "provide": [
                {
                    "name": "ExampleService as service2",
                    "on": "udp",
                    "port": "10001",
                    "instance": 1
                },
                {
                    "name": "EngineService as Engine_red",
                    "on": "mavlink",
                    "instance": 2,
                    "elements": {
                        "CurrentMode": {"radio_a": {}, "radio_b": {"max_rate_hz": 1}},
                        "Telemetry": {"radio_a": {"max_rate_hz": 2}, "radio_b": {"max_rate_hz": 2}},
                        "SetMode": {"radio_a": {}, "radio_b": {}},
                        "DebugDump": {"radio_a": {}, "radio_b": {}}
                    }
                },
                {
                    "name": "EngineService as Engine_a",
                    "on": "mavlink",
                    "instance": 3,
                    "elements": {
                        "CurrentMode": {"radio_a": {}},
                        "Telemetry": {"radio_a": {"max_rate_hz": 1}}
                    }
                }
            ],
            "require": [
                {
                    "name": "ExampleService as service3",
                    "on": "udp",
                    "port": "10001",
                    "instance": 4
                }
            ]
        }
    }
}
