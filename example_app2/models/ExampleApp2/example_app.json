{
    "include": [
        "example_app2/models/ExampleApp2/engine_service.json",
        "example_app2/models/ExampleApp2/example_service.json"
    ],
    "package": "srp.example",
    "adaptive_application": {
        "ExampleApp2": {
            "app": {
                "functional_groups": [
                    "Running",
                    "SafetyMode"
                ],
                "parms": "-t -10- 100",
                "logger": {
                    "app_id": "EXA2",
                    "app_des": "Example Adaptive application",
                    "log_level": "kInfo",
                    "log_mode": "kRemote",
                    "ctx": [
                        {
                            "ctx_id": "ara",
                            "log_level": "kInfo",
                            "ctx_des": "Default ctx for ara"
                        },
                        {
                            "ctx_id": "acom",
                            "log_level": "kDebug",
                            "ctx_des": "Default ctx for ara::com"
                        },
                        {
                            "ctx_id": "adiag",
                            "log_level": "kInfo",
                            "ctx_des": "Default ctx for ara::diag"
                        },
                        {
                            "ctx_id": "exec",
                            "log_level": "kInfo",
                            "ctx_des": "Default ctx for ara::exec"
                        }
                    ]
                }
            },
            "provide": [],
            "require": [
                {
                    "name": "ExampleService as service3",
                    "on": "udp",
                    "port": "10001",
                    "instance": 1
                },
                {
                    "name": "EngineService as Engine_red_in",
                    "on": "mavlink",
                    "instance": 2,
                    "links": [
                        "lora",
                        "wifi"
                    ],
                    "target_system_id": 1,
                    "target_component_id": 1,
                    "source_system_id": 1,
                    "source_component_id": 1
                },
                {
                    "name": "EngineService as Engine_lora_in",
                    "on": "mavlink",
                    "instance": 3,
                    "links": [
                        "lora"
                    ],
                    "target_system_id": 1,
                    "target_component_id": 1,
                    "source_system_id": 1,
                    "source_component_id": 1,
                    "exclude": [
                        "DebugDump"
                    ],
                    "max_rate_hz": {
                        "Telemetry": 1
                    }
                },
                {
                    "name": "EngineService as Engine_wifi_in",
                    "on": "mavlink",
                    "instance": 4,
                    "links": [
                        "wifi"
                    ],
                    "target_system_id": 1,
                    "target_component_id": 1,
                    "source_system_id": 1,
                    "source_component_id": 1,
                    "max_rate_hz": {
                        "Telemetry": 20
                    }
                }
            ],
            "mavlink": {
                "system_id": 2,
                "component_id": 1,
                "dialect": "srp_example"
            },
            "mavlink_links": {
                "lora": {
                    "version": 2,
                    "heartbeat_hz": 1
                },
                "wifi": {
                    "version": 2,
                    "heartbeat_hz": 1
                }
            }
        }
    }
}
