{
    "include": ["tools/model_generator/ara/mavlink/testdata/app/service.json"],
    "package": "srp.mav",
    "adaptive_application": {
        "MavApp": {
            "app": {
                "functional_groups": ["Running"],
                "logger": {
                    "app_id": "MAV-",
                    "app_des": "MAVLink example",
                    "log_level": "kInfo",
                    "log_mode": "kRemote"
                }
            },
            "mavlink": {"system_id": 1, "component_id": 1, "dialect": "srp_radio"},
            "mavlink_links": {
                "radio1": {
                    "version": 2, "heartbeat_hz": 1,
                    "signing": {"enabled": true, "key_file": "/etc/srp/mavlink/radio1.key",
                                "link_id": 1, "accept_unsigned": false}
                },
                "radio2": {"version": 1, "heartbeat_hz": 0},
                "wifi": {},
                "lora": {"version": 2, "heartbeat_hz": 1,
                         "signing": {"enabled": true, "key_file": "/etc/srp/mavlink/lora.key",
                                     "link_id": 2, "accept_unsigned": false,
                                     "state_file": "/var/lib/app/lora.ts"}},
                "spare": {}
            },
            "provide": [
                {"name": "Radio as radio_out", "on": "mavlink", "instance": 3,
                 "links": ["radio1", "lora"]},
                {"name": "Radio as radio_lora", "on": "mavlink", "instance": 5,
                 "links": ["lora"], "exclude": ["Reboot"], "max_rate_hz": {"Position": 0}},
                {"name": "Radio as radio_mix", "on": "mavlink", "instance": 6,
                 "links": ["radio2", "wifi"]}
            ],
            "require": [
                {"name": "Radio as radio_in", "on": "mavlink", "instance": 4,
                 "links": ["wifi"], "target_system_id": 2, "target_component_id": 1,
                 "source_system_id": 2, "source_component_id": 1,
                 "exclude": ["SetName"], "max_rate_hz": {"Position": 5}}
            ]
        }
    }
}
